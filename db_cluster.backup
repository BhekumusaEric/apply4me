    email character varying(255) NOT NULL,
    role character varying(50) DEFAULT 'admin'::character varying,
    permissions jsonb DEFAULT '{}'::jsonb,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    CONSTRAINT admin_users_role_check CHECK (((role)::text = ANY (ARRAY[('admin'::character varying)::text, ('super_admin'::character varying)::text, ('moderator'::character varying)::text])))
);


ALTER TABLE public.admin_users OWNER TO postgres;

--
-- Name: applications; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.applications (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    user_id uuid,
    institution_id uuid,
    program_id uuid,
    status text DEFAULT 'draft'::text,
    personal_details jsonb DEFAULT '{}'::jsonb,
    academic_records jsonb DEFAULT '{}'::jsonb,
    documents jsonb DEFAULT '{}'::jsonb,
    payment_status text DEFAULT 'pending'::text,
    payment_reference text,
    service_type text DEFAULT 'standard'::text,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    payment_method text,
    payment_verification_status text,
    payment_verification_date timestamp with time zone,
    payment_verification_by text,
    payment_verification_notes text,
    yoco_charge_id text,
    submitted_at timestamp with time zone,
    total_amount numeric(10,2),
    payment_date timestamp with time zone,
    personal_info jsonb,
    academic_info jsonb,
    CONSTRAINT applications_payment_status_check CHECK ((payment_status = ANY (ARRAY['pending'::text, 'paid'::text, 'failed'::text, 'refunded'::text, 'pending_verification'::text, 'completed'::text]))),
    CONSTRAINT applications_payment_verification_status_check CHECK ((payment_verification_status = ANY (ARRAY['pending_verification'::text, 'verified'::text, 'rejected'::text]))),
    CONSTRAINT applications_service_type_check CHECK ((service_type = ANY (ARRAY['standard'::text, 'express'::text]))),
    CONSTRAINT applications_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'submitted'::text, 'processing'::text, 'completed'::text, 'rejected'::text, 'payment_failed'::text, 'payment_pending'::text])))
);


ALTER TABLE public.applications OWNER TO postgres;

